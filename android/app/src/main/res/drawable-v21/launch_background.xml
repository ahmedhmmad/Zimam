<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the OS while the process starts, before Flutter's first frame.
     Painting the app's own canvas colour here is what removes the white flash
     on launch; values-night carries the dark equivalent. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
